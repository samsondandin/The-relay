# Groq API configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative models: llama-3.1-8b-instant, mixtral-8x7b-32768

# Model Provider: "groq" or "simulator"
MODEL_PROVIDER=simulator

# Simulator endpoint (if running standalone simulator service)
SIMULATOR_URL=http://127.0.0.1:8001

# Rate Limiter & Budget Settings
RATE_LIMIT_RPM=30
RATE_LIMIT_TPM=6000
DAILY_REQUEST_BUDGET=1000
DAILY_TOKEN_BUDGET=100000
MAX_CONCURRENCY=5
QUEUE_CAPACITY=20
QUEUE_TIMEOUT_SECONDS=10.0

# Retry policy
MAX_RETRIES=1
RETRY_BASE_BACKOFF_SECONDS=0.5
RETRY_MAX_BACKOFF_SECONDS=3.0

# Retrieval settings
DEFAULT_RETRIEVAL_SETTING=B
CHUNKING_STRATEGY=sentence
DATA_DIR=data
PROCESSED_DIR=data/processed
PAPERS_DIR=data/papers

